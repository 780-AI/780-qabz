# Qabz config template (conventions § 8). Copy it to config.yml (git-ignored) and fill in the values:
#   cp config.yml.example config.yml
# This file has every config key, with its default value, or a zero value when the key has no
# default. Never put a real secret, host or token here. A new config key goes into this file and
# into config.yml in the same change.

mode: ""                     # required: dev, stage or prod; the devdb commands run only with dev
service_name: "qabz"
hot_reload_interval: "30s"

service:
  id: 0                      # ID in the payment flow (bill uses 105); sent as serviceId by GET /v1/services

logs:
  level: "info"
  otlp_endpoint: ""          # empty: tracing is off

server:
  grpc:
    addr: ":8082"
  http:
    addr: ":8080"

metrics:
  prometheus:
    addr: ":9090"
    enabled: true            # false: no metric is registered or recorded, no metrics endpoint

database:
  postgres:
    host: "localhost"
    port: 5432
    user: "qabz"
    password: ""             # required
    db: "qabz"
  redis:
    host: "localhost"
    port: 6379
    password: ""
  migration:
    on_start: true
    timeout: "60s"

providers:
  general:
    load_interval: "1m"     # how often the providers table is loaded again; at least 1s; hot-reloadable (key providers_load_interval)
  qabzino:
    grpc_address: ""         # host:port of the Qabzino backend (gRPC, no TLS); empty: every Qabzino call fails as "provider down"
    timeout: "10s"           # limit of each call to the Qabzino backend; positive
    enabled: false           # false: Qabzino cannot be used (every call fails as "provider down", no call to Ayantech, the mock does not apply)
    token: ""                # Ayantech token (secret); the real value only in config.yml
    electricity_bill_endpoint: "https://core.inquiry.ayantech.ir/webservices/core.svc/ElectricityBillInquiry"
    gas_bill_endpoint: "https://core.inquiry.ayantech.ir/webservices/core.svc/GasBillInquiry"
    water_bill_endpoint: "https://core.inquiry.ayantech.ir/webservices/core.svc/WaterBillInquiry"
  tavanir:
    grpc_address: ""         # host:port of the Tavanir backend (gRPC, no TLS); empty: every Tavanir call fails as "provider down"
    timeout: "10s"           # limit of each call to the Tavanir backend; positive
    auth_endpoint: "https://esrv.saapa.ir/api/Users/authenticate"
    basic_branch_endpoint: "https://esrv.saapa.ir/api/ebills/getbranchdata"
    bill_document_endpoint: "https://esrv.saapa.ir/api/ebills/GetLastBillDocument"
    branch_debit_endpoint: "https://esrv.saapa.ir/api/ebills/getbranchdebit"
    username: ""             # Tavanir (SAAPA) user name; the real value only in config.yml
    password: ""             # Tavanir (SAAPA) password (secret); the real value only in config.yml
    circuit_breaker:
      name: "tavanir"
      max_requests: 100000
      interval: "1s"
      timeout: "10s"
      failure_ratio: 99      # percent, 0 to 100

caching:
  water: "1h"                # how long a saved water inquiry answers the same bill with no provider call; 0: cache off
  electricity: "1h"          # how long a saved electricity inquiry answers the same bill with no provider call; 0: cache off

auth:
  secrets:
    hmac: ""                 # the auth service JWT secret; required while the auth check is on

# Development only: a mode other than dev fully removes this section (every debug key keeps its default).
debug:
  auth:
    disable: false
    mock_user_id: ""  # fake user: with disable: true, the user (token sub) of every call; a lower-case UUID, or "" for none
  mocks:                     # provider mocks: the adapter answers a fixed answer, with no call to the backend
    qabzino:
      enable: false
      return_type: "success" # "success" or "error"
    tavanir:
      enable: false
      return_type: "success" # "success" or "error"
